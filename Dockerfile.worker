FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache libc6-compat

ENV NODE_ENV=production

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Prisma client must be generated before the worker can boot. Prisma 7 reads
# prisma.config.ts which calls env('DATABASE_URL') eagerly — supply a
# placeholder for build; runtime DATABASE_URL is injected by compose.
COPY prisma ./prisma
COPY prisma.config.ts ./
ENV DATABASE_URL=postgres://placeholder:placeholder@localhost:5432/placeholder
RUN yarn db:generate

COPY tsconfig.json ./
COPY server ./server
COPY src ./src

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 worker \
    && chown -R worker:nodejs /app

USER worker

CMD ["yarn", "worker"]
