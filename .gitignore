# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager — project uses yarn; reject foreign lockfiles
pnpm-lock.yaml
package-lock.json

# design/plan docs are intentionally untracked
/docs/plans/*-design.md
/docs/plans/*-tasks.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDE
.idea/
.vscode/

# local agent / MCP workspaces
.claude/
.gitnexus/
.playwright-mcp/

# runtime logs from local worker / web (yarn dev:worker writes here)
.runtime/

# bundler caches
.swc/
.turbo/
