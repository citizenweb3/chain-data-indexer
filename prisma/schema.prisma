generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Chain {
  name        String   @id
  displayName String   @map("display_name")
  chainId     String   @unique @map("chain_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  packets        IbcPacket[]
  stats          IbcDailyStats[]
  channels       IbcChannel[]
  cursors        SyncCursor[]
  aggregateState IbcAggregateState?

  @@map("chains")
}

model IbcPacket {
  chain        String
  channelIdSrc String @map("channel_id_src")
  portIdSrc    String @map("port_id_src")
  sequence     BigInt

  portIdDst     String?   @map("port_id_dst")
  channelIdDst  String?   @map("channel_id_dst")
  status        String
  direction     String
  eventHeight   BigInt?   @map("event_height")
  eventTime     DateTime? @map("event_time")
  txHashSend    String?   @map("tx_hash_send")
  heightSend    BigInt?   @map("height_send")
  txHashRecv    String?   @map("tx_hash_recv")
  heightRecv    BigInt?   @map("height_recv")
  txHashAck     String?   @map("tx_hash_ack")
  heightAck     BigInt?   @map("height_ack")
  denom         String?
  amount        Decimal?  @db.Decimal(80, 0)
  memo          String?
  relayer       String?
  timeoutHeight String?   @map("timeout_height")
  timeoutTs     BigInt?   @map("timeout_ts")

  syncedAt DateTime @default(now()) @map("synced_at")

  chainRef Chain @relation(fields: [chain], references: [name])

  @@id([chain, channelIdSrc, portIdSrc, sequence])
  @@index([chain, eventTime(sort: Desc)])
  @@index([chain, channelIdSrc, direction, eventTime(sort: Desc)])
  @@index([chain, denom, eventTime(sort: Desc)])
  @@map("ibc_packets")
}

model Asset {
  id          Int    @id @default(autoincrement())
  symbol      String @unique
  coingeckoId String @map("coingecko_id")
  decimals    Int
  nativeDenom String @unique @map("native_denom")

  prices  Price[]
  history PriceHistory[]

  @@map("assets")
}

model Price {
  id        Int      @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id])
  usd       Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([assetId, createdAt(sort: Desc)])
  @@map("prices")
}

model PriceHistory {
  assetId Int      @map("asset_id")
  asset   Asset    @relation(fields: [assetId], references: [id])
  date    DateTime @db.Date
  usd     Decimal  @db.Decimal(20, 8)

  @@id([assetId, date])
  @@map("price_history")
}

model IbcDailyStats {
  id Int @id @default(autoincrement())

  chain        String
  date         DateTime @db.Date
  channelIdSrc String?  @map("channel_id_src")
  direction    String
  denom        String?

  transfersCount BigInt   @map("transfers_count")
  amountNative   Decimal? @map("amount_native") @db.Decimal(80, 0)
  amountUsd      Decimal? @map("amount_usd") @db.Decimal(30, 8)

  eligiblePackets BigInt?  @map("eligible_packets")
  pricedPackets   BigInt?  @map("priced_packets")
  unpricedPackets BigInt?  @map("unpriced_packets")
  unpricedDenoms  String[] @default([]) @map("unpriced_denoms")

  recomputedAt DateTime @updatedAt @map("recomputed_at")

  chainRef Chain @relation(fields: [chain], references: [name])

  @@unique([chain, date, channelIdSrc, direction, denom], map: "ibc_daily_stats_dim_uniq")
  @@index([chain, date])
  @@map("ibc_daily_stats")
}

model IbcAggregateState {
  chain            String    @id
  version          Int       @default(0)
  correctedFrom    DateTime? @map("corrected_from") @db.Date
  lastRecomputedAt DateTime? @map("last_recomputed_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  chainRef Chain @relation(fields: [chain], references: [name])

  @@map("ibc_aggregate_states")
}

model IbcChannel {
  chain                 String
  channelIdSrc          String  @map("channel_id_src")
  portIdSrc             String  @map("port_id_src")
  counterpartyChainId   String  @map("counterparty_chain_id")
  counterpartyChainName String  @map("counterparty_chain_name")
  counterpartyChannelId String? @map("counterparty_channel_id")
  counterpartyPortId    String? @map("counterparty_port_id")
  clientId              String? @map("client_id")
  status                String?

  updatedAt DateTime @updatedAt @map("updated_at")

  chainRef Chain @relation(fields: [chain], references: [name])

  @@id([chain, channelIdSrc, portIdSrc])
  @@index([counterpartyChainId])
  @@index([counterpartyChannelId, counterpartyPortId], map: "ibc_channels_counterparty_channel_idx")
  @@map("ibc_channels")
}

model SyncCursor {
  chain           String
  key             String
  lastEventHeight BigInt?  @map("last_event_height")
  lastSequence    BigInt?  @map("last_sequence")
  lastChannel     String?  @map("last_channel")
  lastPort        String?  @map("last_port")
  updatedAt       DateTime @updatedAt @map("updated_at")

  chainRef Chain @relation(fields: [chain], references: [name])

  @@id([chain, key])
  @@map("sync_cursors")
}
