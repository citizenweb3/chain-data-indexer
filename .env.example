# Required for local PostgreSQL and Docker Compose.
PG_PASSWORD=CHANGE_ME

# Placeholder Miden node endpoint; confirm with the rpc-client agent output.
NODE_URL=http://127.0.0.1:57291

# PostgreSQL connection
DATABASE_URL=postgresql://miden:CHANGE_ME@localhost:5432/miden_indexer
PG_HOST=localhost
PG_PORT=5432
PG_HOST_PORT=5432
PG_DB=miden_indexer
PG_USER=miden

# Indexer behaviour (runner implementation TBD)
START_BLOCK=0
BATCH_SIZE=100
POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# HTTP API + health endpoint
INDEXER_HTTP_PORT=3001
INDEXER_HTTP_HOST_PORT=3001
