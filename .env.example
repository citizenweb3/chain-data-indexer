# PostgreSQL username used by the container and indexer.
POSTGRES_USER=miden
# PostgreSQL password (REQUIRED, no default). Generate a strong value before deploying.
POSTGRES_PASSWORD=
# PostgreSQL database name initialized on first boot.
POSTGRES_DB=miden_indexer
# Host bind address for PostgreSQL; keep on loopback unless you front it with a firewall.
POSTGRES_HOST_BIND=127.0.0.1
# Host port published for PostgreSQL; 15432 avoids common local 5432 conflicts.
POSTGRES_HOST_PORT=15432

# Miden node RPC endpoint as seen from inside Docker on Linux.
NODE_URL=http://host.docker.internal:57291
# Optional full database URL for local/non-Compose runs.
DATABASE_URL=
# Local/non-Compose PostgreSQL host.
PG_HOST=localhost
# Local/non-Compose PostgreSQL port.
PG_PORT=15432
# Local/non-Compose PostgreSQL database name.
PG_DB=miden_indexer
# Local/non-Compose PostgreSQL username.
PG_USER=miden
# Local/non-Compose PostgreSQL password (REQUIRED to connect).
PG_PASSWORD=
# Postgres TLS mode: disable | require | verify-full.
PG_SSL=disable
# Path to a CA bundle when PG_SSL is require/verify-full.
PG_SSL_CA=

# Container HTTP API port for /health, /metrics, /api/v1/*; compose maps this to API_HOST_PORT.
API_PORT=8080
# Bind address inside the container; 0.0.0.0 because the API is fronted by nginx/UFW.
API_BIND=0.0.0.0
# Host bind address for the API; 0.0.0.0 because the API is public behind nginx.
API_HOST_BIND=0.0.0.0
# Host port published for the HTTP API.
API_HOST_PORT=15080
# Optional Adminer host port when running with --profile debug.
ADMINER_HOST_BIND=127.0.0.1
ADMINER_HOST_PORT=15081

# Optional first block to index when no saved progress exists; leave empty to use the node/default start.
START_BLOCK=
# Blocks requested per indexing batch.
BATCH_SIZE=200
# Poll interval in milliseconds while following the node tip.
POLL_INTERVAL_MS=1500
# Number of concurrent backfill workers.
BACKFILL_CONCURRENCY=16
# Lag threshold before switching to batched catch-up behavior.
MAX_LAG_BLOCKS_BEFORE_BATCH=5
# Log verbosity: debug, info, warn, or error.
LOG_LEVEL=info
# Log format: pretty (human-readable, default for local dev) or json (machine-parseable, default in Docker).
LOG_FORMAT=pretty
# Set to false to disable the Prometheus /metrics route and sampler.
METRICS_ENABLED=true
# Sampler interval for derived gauges (chain tip, pg pool stats) in milliseconds.
METRICS_SAMPLE_INTERVAL_MS=5000
