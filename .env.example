# Required
PG_PASSWORD=change_me

# Logos node HTTP API endpoint (default: local node on port 8080)
NODE_URL=http://localhost:8080

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DB=logos_indexer
PG_USER=logos

# Indexer behaviour
FROM_SLOT=0       # slot to start from (0 = genesis); ignored if progress table has a saved slot
FOLLOW=true       # continue indexing live blocks after backfill
BATCH_SIZE=500    # slots per HTTP request to /cryptarchia/blocks
CONCURRENCY=1     # parallel batch requests (increase carefully — node may rate-limit)
LOG_LEVEL=info    # debug | info | warn | error
