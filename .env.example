# Required
PG_PASSWORD=replace_with_strong_password

# Monero daemon RPC endpoint
NODE_URL=http://localhost:18089

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_HOST_BIND=127.0.0.1
PG_HOST_PORT=5432
PG_DB=monero_indexer
PG_USER=monero
PG_SSL=false
PG_SSL_CA=

# Indexer behaviour
FROM_HEIGHT=0
FOLLOW=true
BATCH_SIZE=200
RPC_CONCURRENCY=16
TX_BATCH_SIZE=200
FOLLOW_POLL_INTERVAL_MS=10000
SETTLEMENT_DEPTH=20
SUPPLY_ENABLED=true
SUPPLY_CHUNK_SIZE=25000
SUPPLY_UPDATE_INTERVAL_MS=3600000
HEALTH_MAX_LAG_BLOCKS=50
HEALTH_MAX_STALL_MS=300000
LOG_LEVEL=info
LOG_FORMAT=pretty

# Explorer API + health endpoint
API_BIND=0.0.0.0
API_PORT=3001
API_HOST_BIND=0.0.0.0
API_HOST_PORT=3001

# Prometheus metrics
METRICS_ENABLED=true
METRICS_SAMPLE_INTERVAL_MS=5000
