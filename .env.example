# =============================================================================
# Cosmos Indexer API — environment variables
# =============================================================================
# Copy to .env and fill in values for local dev (yarn dev) or docker-compose.

# --- Database connection (required) ---
# Indexer Postgres is run by the chain-data-indexer compose project on host port 2432.
# Default targets docker-compose deployment (host-gateway).
# For local dev (yarn dev on host) replace `host.docker.internal` with `localhost`.
DATABASE_URL=postgres://cosmos_indexer_user:CHANGE_ME@host.docker.internal:2432/cosmos_indexer_db

# --- API key for x-api-key header (required) ---
# Comma-separated list is NOT supported yet — single key for MVP.
API_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_SECRET

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Server ---
PORT=3000
NODE_ENV=development

