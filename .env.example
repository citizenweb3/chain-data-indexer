# --- Core RPC ---
RPC_URL=https://rpc.cosmoshub-4-archive.citizenweb3.com

# --- Range selection ---
# FROM=5200792                 # number, optional; or set RESUME=true to continue from sink state
# TO=latest                    # number or "latest"
RESUME=true                   # true to resume from Postgres progress or ClickHouse max(height)
FIRST_BLOCK=27400000            # fallback when resuming and no progress found
FOLLOW=true                    # when TO=latest, keep following new blocks
FOLLOW_INTERVAL_MS=5000        # when TO=latest, poll every n msd

# --- Sharding ---
SHARDS=1                       # total shards
SHARD_ID=0                     # this shard id

# --- Performance / Networking ---
CONCURRENCY=48
DECODE_WORKERS=40              # Half of 80 threads; rest for RPC fetch and PG I/O
TIMEOUT_MS=5000
RPS=500
RETRIES=3
BACKOFF_MS=250
BACKOFF_JITTER=0.3

# --- Logging ---
LOG_LEVEL=info                 # "info" | "debug"

# --- Assembly / Output formatting ---
CASE=snake                     # "snake" | "camel"

# --- Progress logging ---
PROGRESS_EVERY_BLOCKS=1000
PROGRESS_INTERVAL_SEC=15

# --- Sink selection ---
SINK=postgres                    # "stdout" | "null" | "postgres" | "clickhouse"
OUT=-                          # for file sink (if ever needed)
FLUSH_EVERY=100                  # for sinks with buffering

# --- Postgres (for SINK=postgres) ---
PG_DB=cosmos_indexer_db
PG_USER=cosmos_indexer_user
PG_PASSWORD=password
PG_PORT=2432
PG_VERSION=15-bullseye
PG_INITDB_ARGS=--data-checksums
PG_SSL=false                   # true/false
PG_MODE=batch-insert           # "batch-insert" | "block-atomic"

# Bulk mode: defer secondary indexes at DB init for fast backfill.
# The indexer auto-detects their absence and uses COPY FROM instead of INSERT.
# After backfill completes, indexes are created automatically.
PG_DEFER_HEAVY_INDEXES=on     # "on" for fresh backfill, "off" for normal operation

# Batch sizes of buffers (rows buffered before flush)
PG_BATCH_BLOCKS=1000
PG_BATCH_TXS=2000
PG_BATCH_MSGS=5000
PG_BATCH_EVENTS=10000
PG_BATCH_ATTRS=30000
PG_BATCH_TRANSFERS=5000
PG_BATCH_STAKE_DELEG=5000
PG_BATCH_STAKE_DISTR=5000
PG_BATCH_WASM_EXEC=5000
PG_BATCH_WASM_EVENTS=5000
PG_BATCH_GOV_DEPOSITS=5000
PG_BATCH_GOV_VOTES=5000
PG_BATCH_GOV_PROPOSALS=1000

# Connection pool size
PG_POOL_SIZE=16

# Progress identifier (for resume)
PG_PROGRESS_ID=default

# --- ClickHouse (for SINK=clickhouse) ---
# For docker-compose ClickHouse mode, use `make up-clickhouse` or
# `docker compose --env-file .env --profile clickhouse up -d clickhouse indexer-clickhouse`.
CH_URL=http://127.0.0.1:8123   # local HTTP endpoint; docker-compose overrides this to http://clickhouse:8123
CH_DATABASE=core               # default connection database; resume still reads from core.blocks
CH_USERNAME=default
CH_PASSWORD=password
CH_VERSION=24.8
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000

# --- Production / External Access ---
# Bind address for external PostgreSQL access (use 0.0.0.0 for all interfaces)
# PG_EXTERNAL_HOST=0.0.0.0
# 
# IMPORTANT: When exposing PostgreSQL externally, secure with firewall:
#   sudo ufw allow from <VALIDATORINFO_SERVER_IP> to any port 2432
