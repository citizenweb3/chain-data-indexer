# Required
PG_PASSWORD=replace_with_strong_password  # Required; empty/missing value causes startup config failure.

# Logos node HTTP API endpoint (default: local node on port 8080)
NODE_URL=http://localhost:8080

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_HOST_BIND=127.0.0.1 # Docker Compose bind address for PostgreSQL; keep localhost unless needed.
PG_HOST_PORT=5432      # Docker Compose host port for PostgreSQL; change if local 5432 is busy.
PG_DB=logos_indexer
PG_USER=logos
PG_SSL=false           # Set true for remote PostgreSQL that requires TLS.
PG_SSL_CA=             # Optional path to a CA certificate file for PG_SSL=true.

# Indexer behaviour
FROM_SLOT=0       # First slot only when no saved progress exists; saved progress wins.
FOLLOW=true       # true = backfill then live follow; false = backfill then exit.
BATCH_SIZE=500    # Slots per RPC request; lower if the node times out, raise carefully.
LOG_LEVEL=info    # debug | info | warn | error.
LOG_FORMAT=pretty  # pretty for local terminals, json for log shipping.

# Explorer API + health endpoint
API_BIND=0.0.0.0        # Internal listener host for GET /health, /metrics, and /api/*.
API_PORT=3001           # Container/internal HTTP port for GET /health, /metrics, and /api/*.
API_HOST_BIND=0.0.0.0   # Docker Compose host bind; public indexers rely on nginx/firewall/API-token.
API_HOST_PORT=3001      # Docker Compose host port; change if local 3001 is busy.

# Prometheus metrics
METRICS_ENABLED=true
METRICS_SAMPLE_INTERVAL_MS=5000
