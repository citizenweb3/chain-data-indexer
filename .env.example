# =============================================================================
# AtomOne Indexer API — environment variables
# =============================================================================
# Copy to .env and fill in values for local dev (yarn dev) or docker-compose.

# --- Database connection (required) ---
# Production/default docker deployment joins the external `atomone-indexer-net`
# network and talks to the AtomOne Postgres container by name.
# For local dev (yarn dev on host) replace `atomoneindexer:5432` with
# `localhost:2433`.
DATABASE_URL=postgres://atomone_api_ro:CHANGE_ME@atomoneindexer:5432/atomone_indexer_db

# --- API key for x-api-key header (required) ---
# Comma-separated list is NOT supported yet — single key for MVP.
API_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_SECRET

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Server ---
# Host interface for docker port publishing. Keep `127.0.0.1` for local-only
# access; use the server LAN IP to expose the API to nginx or another reverse
# proxy host.
HOST_BIND_IP=127.0.0.1
PORT=3080
NODE_ENV=production
