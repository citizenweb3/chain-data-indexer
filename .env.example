# Postgres credentials — consumed by the `postgres` service in docker-compose.yml
POSTGRES_DB=crosschain
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Application database URL — consumed by `web` and `worker`.
# Host name `postgres` is the compose service name; switch to `localhost` for non-docker dev.
DATABASE_URL=postgres://app:app@postgres:5432/crosschain

# Cosmos Hub upstream — chain-data-indexer ibc-api deployment
COSMOSHUB_INDEXER_BASE_URL=https://indexer.cosmoshub.example.com/api/v1
COSMOSHUB_INDEXER_API_KEY=replace-me

# AtomOne upstream — indexer.atomone.citizenweb3.com
ATOMONE_INDEXER_BASE_URL=https://indexer.atomone.citizenweb3.com/api/v1
ATOMONE_INDEXER_API_KEY=replace-me

# CoinGecko (optional; falls back to public free tier when empty)
COINGECKO_API_KEY=

# Logging
LOG_LEVEL=info

# HTTP port the `web` container listens on (also exposed by Next.js dev)
PORT=3000
