# --- Core RPC ---
RPC_URL=http://192.168.5.218:26957
APP_NAME=atomone-indexer
INDEXER_RESTART_POLICY=no

# --- Range selection ---
# Smoke-test range for this server. Use FROM=1, TO=10000, FOLLOW=false before any long backfill elsewhere.
FROM=1                         # number, optional; or set RESUME=true to continue from DB progress
TO=10000                       # number or "latest"
RESUME=false                   # true to resume from DB progress
FIRST_BLOCK=1                  # fallback when resuming and no progress found
FOLLOW=false                   # when TO=latest, keep following new blocks
FOLLOW_INTERVAL_MS=5000        # when TO=latest, poll every n msd

# --- Sharding ---
SHARDS=1                       # total shards
SHARD_ID=0                     # this shard id

# --- Performance / Networking ---
CONCURRENCY=16
DECODE_WORKERS=40              # Half of 80 threads; rest for RPC fetch and PG I/O
TIMEOUT_MS=5000
RPS=100
RETRIES=3
BACKOFF_MS=250
BACKOFF_JITTER=0.3

# --- Logging ---
LOG_LEVEL=info                 # "info" | "debug"
LOG_FORMAT=pretty              # "pretty" (default, human-readable) | "json" (for Loki/ELK ingestion)

# --- Assembly / Output formatting ---
CASE=snake                     # "snake" | "camel"

# --- Progress logging ---
PROGRESS_EVERY_BLOCKS=1000
PROGRESS_INTERVAL_SEC=15

# --- Sink selection ---
SINK=postgres                    # "stdout" | "null" | "postgres" (see below)
OUT=-                          # for file sink (if ever needed)
FLUSH_EVERY=100                  # for sinks with buffering

# --- Postgres (for SINK=postgres) ---
# can be set in one line:
PG_DB=atomone_indexer_db
PG_USER=atomone_indexer_user
PG_PASSWORD=password
PG_PORT=2433
PG_VERSION=16
PG_INITDB_ARGS=--data-checksums
PG_SSL=false                   # true/false
PG_MODE=batch-insert           # "batch-insert" | "block-atomic"

# Batch sizes of buffers (default values below)
PG_BATCH_BLOCKS=1000
PG_BATCH_TXS=2000
PG_BATCH_MSGS=5000
PG_BATCH_EVENTS=10000
PG_BATCH_ATTRS=30000

# Bulk ingest mode: drops secondary indexes, uses COPY FROM, disables autovacuum.
# Set to true for initial backfill. Indexes are auto-restored on follow transition.
PG_BULK_MODE=false

# Connection pool size
PG_POOL_SIZE=16

# Progress identifier (for resume)
PG_PROGRESS_ID=atomone

# --- Production / External Access ---
# Bind address for external PostgreSQL access (use 0.0.0.0 for all interfaces)
# PG_EXTERNAL_HOST=0.0.0.0
# 
# IMPORTANT: When exposing PostgreSQL externally, secure with firewall:
PG_EXTERNAL_HOST=127.0.0.1
#   sudo ufw allow from <VALIDATORINFO_SERVER_IP> to any port 2433

# Health endpoint (Level 1 monitoring)
HEALTH_PORT=3031
HEALTH_STALE_SECONDS=180
HEALTH_STARTUP_GRACE_SECONDS=300
HEALTH_ENABLED=true
# Bind health port to localhost only by default; set 0.0.0.0 to expose externally
HEALTH_EXTERNAL_HOST=127.0.0.1

# Prometheus metrics (Level 2 monitoring) — exposed on the same HEALTH_PORT at /metrics
METRICS_ENABLED=true
METRICS_SAMPLE_INTERVAL_MS=5000
