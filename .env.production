# =============================================================================
# Chain Data Indexer — HIGH-PERFORMANCE SERVER CONFIGURATION
# Optimized for: 40 cores / 80 threads, 320 GB RAM
# =============================================================================

# --- Core RPC ---
RPC_URL=https://rpc.cosmoshub-4-archive.citizenweb3.com

# --- Range selection ---
# FROM=1                        # Explicit start (optional if RESUME=true)
# TO=latest                     # number or "latest"
RESUME=true                     # Resume from last DB progress
FIRST_BLOCK=5200792             # Cosmoshub-4 genesis block (after Stargate upgrade)
FOLLOW=true                     # Follow new blocks after sync
FOLLOW_INTERVAL_MS=3000         # Poll every 3s (faster follow)

# --- Sharding (single instance) ---
SHARDS=1
SHARD_ID=0

# --- Performance / Networking (AGGRESSIVE) ---
# With 80 threads, we can push much higher concurrency
CONCURRENCY=256                 # Parallel block fetches (was 48)
TIMEOUT_MS=15000                # 15s timeout (increased for stability)
RPS=2000                        # Requests per second (was 500)
RETRIES=5                       # More retries for reliability
BACKOFF_MS=200                  # Faster retry
BACKOFF_JITTER=0.25

# --- Logging ---
LOG_LEVEL=info                  # "info" | "debug" | "warn"

# --- Assembly / Output formatting ---
CASE=snake                      # "snake" | "camel"

# --- Progress logging ---
PROGRESS_EVERY_BLOCKS=5000      # Less frequent progress logs
PROGRESS_INTERVAL_SEC=30        # Every 30 seconds

# --- Sink selection ---
SINK=postgres
OUT=-
FLUSH_EVERY=500                 # Flush every 500 blocks (was 100)

# --- PostgreSQL Connection ---
PG_DB=cosmos_indexer_db
PG_USER=cosmos_indexer_user
PG_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
PG_PORT=2432
PG_VERSION=16
PG_INITDB_ARGS=--data-checksums
PG_SSL=false
PG_MODE=batch-insert

# --- PostgreSQL Batch Sizes (LARGE for high-throughput) ---
# With 320GB RAM, we can use much larger batches
PG_BATCH_BLOCKS=5000            # 5x default
PG_BATCH_TXS=10000              # 5x default
PG_BATCH_MSGS=25000             # 5x default
PG_BATCH_EVENTS=50000           # 5x default
PG_BATCH_ATTRS=150000           # 5x default

# --- PostgreSQL Connection Pool ---
PG_POOL_SIZE=64                 # Large pool for parallel inserts (was 16)

# --- Progress identifier ---
PG_PROGRESS_ID=default

# --- Node.js Memory ---
# With 320GB RAM, allocate plenty for Node.js heap
# Workers will use additional memory outside this limit
NODE_OPTIONS=--max-old-space-size=65536

# --- Production / External Access ---
# Bind PostgreSQL to all interfaces for external connections
PG_EXTERNAL_HOST=0.0.0.0

# IMPORTANT: Secure with firewall!
# sudo ufw allow from <VALIDATORINFO_SERVER_IP> to any port 2432
