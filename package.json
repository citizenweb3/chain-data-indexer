{
  "name": "logos-indexer",
  "version": "0.1.2",
  "description": "Block indexer for Logos Blockchain testnet",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "bash -lc 'for f in initdb/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done'"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
