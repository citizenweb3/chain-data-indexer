# ============================================
# Aztec Indexer Configuration
# Copy this file to .env.indexer and configure
# ============================================

# ============================================
# YOUR AZTEC RPC NODE (REQUIRED)
# ============================================
# Format: name::url (multiple nodes separated by comma)
AZTEC_RPC_URLS=mainnet::https://rpc.aztec.citizenweb3.com

# Example for multiple nodes (failover):
# AZTEC_RPC_URLS=primary::https://rpc.aztec.citizenweb3.com,backup::https://rpc.aztec.citizenweb3.com

# ============================================
# Network Configuration
# ============================================
# Options: SANDBOX, TESTNET, DEVNET, MAINNET, or custom identifier
L2_NETWORK_ID=MAINNET

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chicmoz
POSTGRES_PASSWORD=chicmoz123

# ============================================
# Kafka Configuration
# ============================================
KAFKA_CONNECTION=localhost:9092
KAFKA_PORT=9092

# ============================================
# API Configuration
# ============================================
API_PORT=8000
API_KEYS=dev

# ============================================
# Indexer Settings
# ============================================
# Block polling interval in milliseconds
BLOCK_POLL_INTERVAL_MS=3000

# Catchup mode delay between blocks (faster = more load on RPC)
CATCHUP_POLL_WAIT_TIME_MS=100

# Listen for pending transactions
AZTEC_LISTEN_FOR_PENDING_TXS=true

# Listen for chain info updates
AZTEC_LISTEN_FOR_CHAIN_INFO=true

# ============================================
# Advanced: Start from Specific Block Height
# ============================================
# Uncomment to skip historical blocks and start from specific height
# AZTEC_LISTEN_FOR_PROPOSED_BLOCKS_FORCED_START_FROM_HEIGHT=1000
# AZTEC_LISTEN_FOR_PROVEN_BLOCKS_FORCED_START_FROM_HEIGHT=1000

# Ignore previously saved height (reindex from scratch)
# IGNORE_PROCESSED_HEIGHT=true

# Disable eternal catchup (background reindexing)
# AZTEC_DISABLE_ETERNAL_CATCHUP=true

# ============================================
# Optional: Kafka UI for debugging
# ============================================
KAFKA_UI_PORT=8081
